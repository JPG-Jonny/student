# =========================================================================
# EDUPULSE ERP - ENVIRONMENT CONFIGURATION
# =========================================================================

# PostgreSQL Database Configuration
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://edupulse:edupulse_password@localhost:5432/edupulse

# FastAPI Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8000
FASTAPI_DEBUG=True

# Application Settings
APP_NAME=EduPulse ERP
APP_VERSION=1.0.0

# Security (Consider using environment-based secrets in production)
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500

# Logging
LOG_LEVEL=INFO
